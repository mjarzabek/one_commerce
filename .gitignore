# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

/.bundle

# Environment files
/.env*

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Uploaded files in development
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Credentials keys
/config/master.key
/config/credentials/*.key

# Vite Ruby
/public/vite*
node_modules
*.local

# Local tooling
/.preview
/.claude/
.DS_Store
