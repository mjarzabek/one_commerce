<!DOCTYPE html>
<html lang="pl">
  <head>
    <title data-inertia><%= content_for(:title) || Rails.configuration.x.app_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="<%= Rails.configuration.x.app_name %>">
    <%# Motyw (jasny/ciemny/systemowy) ustawiany przed renderem – logika jak w hooks/use-theme.ts. %>
    <script>
      (function () {
        try {
          var t = localStorage.getItem("theme")
          var dark = t === "dark" || (t !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches)
          document.documentElement.classList.toggle("dark", dark)
        } catch (e) {}
      })()
    </script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= vite_stylesheet_tag "application.css" %>
    <%= vite_react_refresh_tag %>
    <%= vite_client_tag %>
    <%= vite_typescript_tag "inertia.tsx" %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
